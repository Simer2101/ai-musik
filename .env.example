# Copy to apps/api/.env and apps/mobile/.env as needed.

# --- API (apps/api/.env) ---
PORT=8787
PUBLIC_APP_URL=https://aimusik.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=123456:your-bot-token
GITHUB_REPO=Simer2101/ai-musik
GITHUB_BRANCH=main
CORS_ORIGINS=*

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_TELEGRAM_BOT_ID=123456
EXPO_PUBLIC_TELEGRAM_CALLBACK_URL=https://YOUR_SITE/telegram-callback.html

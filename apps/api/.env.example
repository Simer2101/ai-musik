# Copy to apps/api/.env for local runs. On Timeweb App Platform set the same names
# under the app's Environment variables instead.
PORT=8787
PUBLIC_APP_URL=https://sonari.app

# Timeweb Cloud → Databases → PostgreSQL → Connection. Without it the API serves the catalog only.
DATABASE_URL=postgresql://gen_user:YOUR_PASSWORD@YOUR_HOST:5432/default_db
# true when connecting to the database's public address (TLS).
DATABASE_SSL=true
SESSION_DAYS=180

# @BotFather → your bot → API token.
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# sms.ru → Settings → API (api_id). Leave empty to switch phone sign-in off.
SMS_RU_API_ID=
# Local development only: print SMS codes to the log instead of sending them.
SMS_DEV_ECHO=false

GITHUB_REPO=Simer2101/ai-musik
GITHUB_BRANCH=main
CORS_ORIGINS=*
